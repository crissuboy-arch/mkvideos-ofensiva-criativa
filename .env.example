# mkivideos — variáveis de ambiente (referência).
# Copie para `.env` e ajuste. O `.env` real NUNCA é versionado (ver .gitignore).
# Todas têm default seguro — o projeto funciona sem `.env`.

# ─────────────────────────────────────────────────────────────────────────────
# Núcleo (gerar / painel / fila)
# ─────────────────────────────────────────────────────────────────────────────
# Caminho do banco SQLite (fila + centro de operações)
# MKIVIDEOS_DB=./mkivideos.db
# Pasta-raiz de vozes personalizadas (vozes/<nome>/s1.wav …)
# MKIVIDEOS_VOZES=C:\Users\voce\meus-videos-ia\vozes

# Render (HyperFrames) — todos opcionais
# MKIVIDEOS_GPU=0
# MKIVIDEOS_RENDER_QUALITY=high        # draft | standard | high
# MKIVIDEOS_RENDER_FPS=
# MKIVIDEOS_RENDER_WORKERS=
# MKIVIDEOS_LOW_MEMORY=0
# MKIVIDEOS_RENDER_TIMEOUT_MS=1200000

# ─────────────────────────────────────────────────────────────────────────────
# URL → Vídeo (motor: modules/content2video)
# ─────────────────────────────────────────────────────────────────────────────
# Motor ativo (só 'content2video' hoje)
# MKIVIDEOS_ENGINE=content2video

# Defaults do fluxo URL → Vídeo
# MKIVIDEOS_URL2VIDEO_FORMAT=9:16      # 9:16 | 16:9 | vertical | horizontal
# MKIVIDEOS_URL2VIDEO_STYLE=popular    # popular | natural | technical
# MKIVIDEOS_URL2VIDEO_PACE=natural     # calm | natural | fast
# MKIVIDEOS_URL2VIDEO_CTA=1            # 1/0 — anexar CTA da marca ao final
# MKIVIDEOS_URL2VIDEO_PRESET=          # id de preset visual (vazio = automático)

# Processo do motor content2video (loopback; gerido pelo MKVideos)
# MKIVIDEOS_C2V_URL=                   # se definido, usa este motor externo e NÃO sobe processo
# MKIVIDEOS_C2V_HOST=127.0.0.1
# MKIVIDEOS_C2V_PORT=0                 # 0 = porta automática
# MKIVIDEOS_C2V_PREVIEW_HOST=127.0.0.1
# MKIVIDEOS_C2V_BOOT_TIMEOUT_MS=20000

# ─────────────────────────────────────────────────────────────────────────────
# Provedor de IA usado pelo motor content2video (pesquisa a fonte + roteiro).
# NÃO gera clipes de vídeo — só orquestra roteiro/cenas/metadados.
# ─────────────────────────────────────────────────────────────────────────────
# AI_PROVIDER=codex                    # codex (OAuth via `codex login`) | openai
# OPENAI_API_KEY=                      # SEGREDO — só quando AI_PROVIDER=openai. Nunca commitar.
# OPENAI_MODEL=

# Defaults editoriais do motor (herdados por modules/content2video/config)
# OUTPUT_LANGUAGE=pt-BR
# VOICE_PROVIDER=edge-tts
# VOICE_ID=pt-BR-FranciscaNeural
# TARGET_DURATION_SECONDS=60
# MINIMUM_DURATION_SECONDS=42
# MAXIMUM_DURATION_SECONDS=78
# MINIMUM_QUALITY_SCORE=8
# VIDEO_FPS=30
# RENDER_QUALITY=high

# ─────────────────────────────────────────────────────────────────────────────
# Módulos locais: Música + Videoclipe / Otimizar Vídeo / Legendar
# ─────────────────────────────────────────────────────────────────────────────
# Raiz dos dados locais desses módulos (default: ./.mkvideos-data — gitignored)
# MKIVIDEOS_DATA_DIR=
# Executáveis (default: autodetect)
# MKIVIDEOS_PYTHON=
# MKIVIDEOS_FFMPEG=ffmpeg
# Teto de gasto por chamada paga (US$). Bloqueia mesmo com confirmação. Vazio = sem teto.
# MKIVIDEOS_COST_CEILING_USD=

# --- Chaves de provider (SEGREDOS — nunca commitar). Provider sem chave aparece
#     como indisponível; provider pago nunca roda sem confirmação explícita. ---

# Música + Videoclipe (musicavideo)
# KIE_API_KEY=          # SEGREDO — Suno v4.5 via kie.ai (~US$0,08/geração, traz 2 faixas). A ÚNICA parte paga por default.
# AGNES_API_KEY=        # capa + clipe a custo ZERO (default). https://apihub.agnes-ai.com
# FAL_KEY=              # SEGREDO — alternativas pagas de clipe/imagem (fal.ai). Opcional.

# Otimizar Vídeo (otimizevideo) e Legendar (transcrição)
# GROQ_API_KEY=         # SEGREDO — transcrição (Whisper via Groq). ~US$0,04/hora de áudio.
# OPENROUTER_API_KEY=   # SEGREDO — pontuação/classificação visual (glm/gemini). Barato (~US$0,004/vídeo).
# ELEVENLABS_API_KEY=   # SEGREDO — narração paga (opcional; default é inemavox local).
# ELEVENLABS_VOICE_ID=

# Daemons locais opcionais (custo zero): Ollama (pontuação) e inemavox (TTS)
# — o MKVideos só os usa se estiverem no ar em http://localhost:11434 / :8010.

# ─────────────────────────────────────────────────────────────────────────────
# Publicação para a vitrine pública (musicavideo-pub / Hugging Face)
# NÃO integrada ao MKVideos — ver modules/musicavideo-pub/ORIGEM.md.
# ─────────────────────────────────────────────────────────────────────────────
